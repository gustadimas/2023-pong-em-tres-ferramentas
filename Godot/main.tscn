[sub_resource type="GDScript" id=4]
resource_name = "GameController"
script/source = "extends Node

# Variáveis da bola
var dirX = 1
var dirY = -1
var speed = 400

# Called when the node enters the scene tree for the first time.
func _ready():
	pass # Replace with function body.

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta):
	ball(delta)
	player1()
	pass

func ball(delta):
	$Ball/Ball.position.x += speed * dirX * delta
	$Ball/Ball.position.y += speed * dirY * delta
	
	if $Ball/Ball.position.x > 1360:
		$Ball/Ball.position.x = 640	
		$Ball/Ball.position.y = 365	
		dirX *= -1
	elif $Ball/Ball.position.x < -1360:
		$Ball/Ball.position.x = 640
		$Ball/Ball.position.y = 365
		dirX *= -1

func _on_Barrier_Down_area_entered(area):
	if area.name == \"Ball\":
		dirY *= -1
	pass


func _on_Barrier_Up_area_entered(area):
	if area.name == \"Ball\":
		dirY *= -1
	pass

func player1():
	if Input.is_action_pressed(\"ui_down\"):
		$Players/Player1.position.y += 4
	elif Input.is_action_pressed(\"ui_up\"):
		$Players/Player1.position.y -= 4
		
	if $Players/Player1.position.y > 590:
		$Players/Player1.position.y = 590
	elif $Players/Player1.position.y < 140:
			$Players/Player1.position.y = 140
"

